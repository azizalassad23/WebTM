  {
    "id": "html-lanjutan-028",
    "modul": "HTML", "level": "Lanjutan", "chapterId": "html-10", "chapterModul": "html",
    "topik": "Form Validasi",
    "instruksi": "Buat isian email yang wajib diisi (<code>type=\"email\"</code> + <code>required</code>) dan isian NISN bertipe teks dengan <code>pattern=\"[0-9]{10}\"</code> serta atribut <code>title</code> yang menjelaskan formatnya.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Validasi</title>\n</head>\n<body>\n\n  <form>\n\n    <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n    <button type=\"submit\">Kirim</button>\n  </form>\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "input[type='email']", "poin": 20, "label": "input bertipe email" },
      { "type": "attribute_exists", "selector": "input[type='email']", "attribute": "required", "poin": 25, "label": "isian email wajib diisi" },
      { "type": "attribute_equals", "selector": "input[pattern]", "attribute": "pattern", "expected": "[0-9]{10}", "poin": 30, "label": "pattern NISN benar" },
      { "type": "attribute_exists", "selector": "input[pattern]", "attribute": "title", "poin": 25, "label": "pattern disertai title penjelas", "hint": "Tanpa title, pesan error browser tidak menyebut formatnya." }
    ],
    "total_poin": 100
  },
  {
    "id": "html-lanjutan-029",
    "modul": "HTML", "level": "Lanjutan", "chapterId": "html-10", "chapterModul": "html",
    "topik": "Form Validasi",
    "instruksi": "Buat isian angka bernama <code>nilai</code> dengan <code>type=\"number\"</code>, <code>min=\"0\"</code>, <code>max=\"100\"</code>, dan isian tanggal <code>type=\"date\"</code> yang <code>required</code>. Tambahkan <code>autocomplete=\"name\"</code> pada isian nama.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Batas Nilai</title>\n</head>\n<body>\n\n  <form>\n    <label for=\"nama\">Nama</label>\n    <input type=\"text\" id=\"nama\" name=\"nama\">\n\n    <!-- ✏️ TULIS ISIAN LAIN DI SINI, DAN LENGKAPI ISIAN NAMA DI ATAS -->\n\n  </form>\n\n</body>\n</html>" },
    "assertions": [
      { "type": "attribute_equals", "selector": "input[type='number']", "attribute": "name", "expected": "nilai", "poin": 20, "label": "input angka bernama \"nilai\"" },
      { "type": "attribute_equals", "selector": "input[type='number']", "attribute": "min", "expected": "0", "poin": 20, "label": "min=\"0\"" },
      { "type": "attribute_equals", "selector": "input[type='number']", "attribute": "max", "expected": "100", "poin": 20, "label": "max=\"100\"" },
      { "type": "attribute_exists", "selector": "input[type='date']", "attribute": "required", "poin": 20, "label": "isian tanggal wajib diisi" },
      { "type": "attribute_equals", "selector": "#nama", "attribute": "autocomplete", "expected": "name", "poin": 20, "label": "autocomplete=\"name\" pada isian nama" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-lanjutan-030",
    "modul": "HTML", "level": "Lanjutan", "chapterId": "html-10", "chapterModul": "html",
    "topik": "Aksesibilitas Dasar",
    "instruksi": "Buat isian pencarian <code>type=\"search\"</code> tanpa label terlihat, tetapi tetap dikenali pembaca layar lewat <code>aria-label=\"Cari materi\"</code>. Hubungkan juga isian itu ke teks bantuan ber-<code>id=\"bantuan\"</code> memakai <code>aria-describedby</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Pencarian</title>\n</head>\n<body>\n\n  <form>\n\n    <!-- ✏️ TULIS ISIAN PENCARIAN DI SINI -->\n\n    <small id=\"bantuan\">Ketik kata kunci lalu tekan Enter.</small>\n  </form>\n\n</body>\n</html>" },
    "assertions": [
      { "type": "attribute_equals", "selector": "input", "attribute": "type", "expected": "search", "poin": 25, "label": "input bertipe search" },
      { "type": "attribute_equals", "selector": "input", "attribute": "aria-label", "expected": "Cari materi", "poin": 40, "label": "aria-label = \"Cari materi\"" },
      { "type": "attribute_equals", "selector": "input", "attribute": "aria-describedby", "expected": "bantuan", "poin": 35, "label": "aria-describedby menunjuk #bantuan" }
    ],
    "total_poin": 100
  },

