[
  {
    "id": "html-dasar-001",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-01", "chapterModul": "html",
    "topik": "Pengenalan HTML",
    "instruksi": "Di dalam <code>&lt;body&gt;</code>, buat heading level 1 dengan teks <code>Profil Saya</code>, diikuti sebuah paragraf berisi minimal 5 kata.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Latihan HTML</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "h1", "poin": 30, "label": "elemen <h1> ditemukan" },
      { "type": "text_content_equals", "selector": "h1", "expected": "Profil Saya", "poin": 30, "label": "teks <h1> = \"Profil Saya\"", "hint": "Periksa ejaan dan huruf besar-kecilnya." },
      { "type": "element_exists", "selector": "p", "poin": 20, "label": "elemen <p> ditemukan" },
      { "type": "text_min_word_count", "selector": "p", "min_words": 5, "poin": 20, "label": "paragraf minimal 5 kata" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-002",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-01", "chapterModul": "html",
    "topik": "Pengenalan HTML",
    "instruksi": "Buat sebuah paragraf yang memuat kata bertanda <code>&lt;strong&gt;</code> dan kata bertanda <code>&lt;em&gt;</code>. Di bawahnya tambahkan garis pemisah <code>&lt;hr&gt;</code>, lalu satu paragraf lagi.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Latihan HTML</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "p strong", "poin": 30, "label": "<strong> berada di dalam paragraf" },
      { "type": "element_exists", "selector": "p em", "poin": 30, "label": "<em> berada di dalam paragraf" },
      { "type": "element_exists", "selector": "hr", "poin": 20, "label": "garis pemisah <hr> ditemukan" },
      { "type": "element_count_min", "selector": "p", "min": 2, "poin": 20, "label": "ada minimal 2 paragraf" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-003",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-01", "chapterModul": "html",
    "topik": "Pengenalan HTML",
    "instruksi": "Buat satu <code>&lt;div&gt;</code> ber-<code>class=\"kotak\"</code> yang di dalamnya ada <code>&lt;h2&gt;</code> dan sebuah <code>&lt;span&gt;</code>. Tambahkan juga satu paragraf di dalam <code>.kotak</code> tersebut.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Latihan HTML</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "div.kotak", "poin": 30, "label": "<div class=\"kotak\"> ditemukan" },
      { "type": "element_exists", "selector": "div.kotak h2", "poin": 30, "label": "<h2> di dalam .kotak" },
      { "type": "element_exists", "selector": "div.kotak span", "poin": 25, "label": "<span> di dalam .kotak" },
      { "type": "element_exists", "selector": "div.kotak p", "poin": 15, "label": "<p> di dalam .kotak" }
    ],
    "total_poin": 100
  },

  {
    "id": "html-dasar-004",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-02", "chapterModul": "html",
    "topik": "Struktur Dokumen",
    "instruksi": "Lengkapi kerangka dokumen: atur bahasa dokumen menjadi Indonesia (<code>lang=\"id\"</code>), ganti isi <code>&lt;title&gt;</code> menjadi <code>Halaman Saya</code>, dan tambahkan satu <code>&lt;h1&gt;</code> di dalam <code>&lt;body&gt;</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Ganti judul ini</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "attribute_equals", "selector": "html", "attribute": "lang", "expected": "id", "poin": 25, "label": "<html lang=\"id\">" },
      { "type": "element_exists", "selector": "head title", "poin": 20, "label": "<title> berada di dalam <head>" },
      { "type": "text_content_equals", "selector": "title", "expected": "Halaman Saya", "poin": 30, "label": "teks <title> = \"Halaman Saya\"" },
      { "type": "element_exists", "selector": "body h1", "poin": 25, "label": "<h1> berada di dalam <body>" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-005",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-02", "chapterModul": "html",
    "topik": "Struktur Dokumen",
    "instruksi": "Bagian <code>&lt;head&gt;</code> masih kosong. Tambahkan <code>&lt;meta charset=\"utf-8\"&gt;</code>, meta viewport dengan <code>content=\"width=device-width, initial-scale=1\"</code>, dan <code>&lt;title&gt;</code> berisi <code>Kerangka Lengkap</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</head>\n<body>\n  <h1>Halo</h1>\n</body>\n</html>" },
    "assertions": [
      { "type": "attribute_equals", "selector": "meta[charset]", "attribute": "charset", "expected": "utf-8", "poin": 30, "label": "meta charset utf-8" },
      { "type": "attribute_equals", "selector": "meta[name='viewport']", "attribute": "content", "expected": "width=device-width, initial-scale=1", "poin": 35, "label": "meta viewport benar" },
      { "type": "text_content_equals", "selector": "title", "expected": "Kerangka Lengkap", "poin": 35, "label": "teks <title> = \"Kerangka Lengkap\"" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-006",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-02", "chapterModul": "html",
    "topik": "Struktur Dokumen",
    "instruksi": "Di dalam <code>&lt;body&gt;</code>, buat dua elemen <strong>block</strong> berupa <code>&lt;div&gt;</code> berurutan, lalu satu paragraf yang di dalamnya berisi dua elemen <strong>inline</strong> berupa <code>&lt;span&gt;</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Block dan Inline</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_count_min", "selector": "body > div", "min": 2, "poin": 40, "label": "ada minimal 2 <div> langsung di dalam <body>" },
      { "type": "element_exists", "selector": "p span", "poin": 30, "label": "<span> berada di dalam paragraf" },
      { "type": "descendant_count_min", "selector": "p", "child_selector": "span", "min": 2, "poin": 30, "label": "paragraf berisi minimal 2 <span>" }
    ],
    "total_poin": 100
  },

  {
    "id": "html-dasar-007",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-03", "chapterModul": "html",
    "topik": "Teks & Heading",
    "instruksi": "Buat <code>&lt;h1&gt;</code> berisi <code>Catatan Harian</code>, lalu <code>&lt;h2&gt;</code> di bawahnya, lalu <code>&lt;h3&gt;</code>. Jangan melompati tingkat heading.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Catatan Harian</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "text_content_equals", "selector": "h1", "expected": "Catatan Harian", "poin": 35, "label": "teks <h1> = \"Catatan Harian\"" },
      { "type": "element_exists", "selector": "h2", "poin": 35, "label": "elemen <h2> ditemukan" },
      { "type": "element_exists", "selector": "h3", "poin": 30, "label": "elemen <h3> ditemukan" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-008",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-03", "chapterModul": "html",
    "topik": "Teks & Heading",
    "instruksi": "Buat sebuah <code>&lt;blockquote&gt;</code> berisi kutipan minimal 6 kata, dan sebuah <code>&lt;pre&gt;</code> berisi dua baris teks yang spasinya dipertahankan.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Kutipan</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "blockquote", "poin": 25, "label": "<blockquote> ditemukan" },
      { "type": "text_min_word_count", "selector": "blockquote", "min_words": 6, "poin": 30, "label": "kutipan minimal 6 kata" },
      { "type": "element_exists", "selector": "pre", "poin": 25, "label": "<pre> ditemukan" },
      { "type": "computed_style_contains", "selector": "pre", "property": "white-space", "contains": "pre", "poin": 20, "label": "<pre> mempertahankan spasi" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-009",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-03", "chapterModul": "html",
    "topik": "Teks & Heading",
    "instruksi": "Buat paragraf ber-<code>id=\"entitas\"</code> yang menampilkan teks persis: <code>Tag &lt;p&gt; &amp; &lt;h1&gt;</code>. Gunakan entitas HTML agar tanda kurung siku benar-benar tampil sebagai teks.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Entitas</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n  <!-- Petunjuk: tanda kurung siku harus ditulis sebagai entitas HTML -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "p#entitas", "poin": 30, "label": "<p id=\"entitas\"> ditemukan" },
      { "type": "text_content_equals", "selector": "p#entitas", "expected": "Tag <p> & <h1>", "poin": 50, "label": "teks tampil persis: Tag <p> & <h1>", "hint": "Gunakan &lt; &gt; dan &amp; — bukan tanda kurung siku langsung." },
      { "type": "source_matches", "target": "html", "pattern": "&lt;|&gt;", "poin": 20, "label": "memakai entitas HTML", "describe": "&lt; atau &gt;" }
    ],
    "total_poin": 100
  },

  {
    "id": "html-dasar-010",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-04", "chapterModul": "html",
    "topik": "List & Link",
    "instruksi": "Isi <code>&lt;ul&gt;</code> yang sudah disediakan dengan tiga mata pelajaran favorit Anda. Item terakhir harus berupa tautan menuju <code>https://sekolah.sch.id</code> yang terbuka di tab baru.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Mata Pelajaran</title>\n</head>\n<body>\n\n  <h1>Mata Pelajaran Favorit</h1>\n\n  <ul>\n    <!-- ✏️ TULIS TIGA <li> DI SINI -->\n  </ul>\n\n</body>\n</html>" },
    "assertions": [
      { "type": "descendant_count_min", "selector": "ul", "child_selector": "li", "min": 3, "poin": 40, "label": "<ul> berisi minimal 3 <li>" },
      { "type": "attribute_equals", "selector": "ul li a", "attribute": "href", "expected": "https://sekolah.sch.id", "poin": 30, "label": "atribut href benar" },
      { "type": "attribute_equals", "selector": "ul li a", "attribute": "target", "expected": "_blank", "poin": 30, "label": "target=\"_blank\"", "hint": "Tambahkan target=\"_blank\" pada tag <a>." }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-011",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-04", "chapterModul": "html",
    "topik": "List & Link",
    "instruksi": "Buat daftar <strong>berurutan</strong> ber-<code>id=\"langkah\"</code> berisi tiga langkah memasang GitHub Pages. Item pertama harus mengandung sub-daftar <code>&lt;ul&gt;</code> dengan minimal dua item.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Langkah Deploy</title>\n</head>\n<body>\n\n  <h1>Langkah Deploy</h1>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "ol#langkah", "poin": 30, "label": "<ol id=\"langkah\"> ditemukan" },
      { "type": "descendant_count_min", "selector": "ol#langkah", "child_selector": "li", "min": 3, "poin": 30, "label": "berisi minimal 3 <li>" },
      { "type": "element_exists", "selector": "ol#langkah li ul li", "poin": 40, "label": "ada sub-daftar <ul> di dalam <li>", "hint": "Sub-daftar ditulis di dalam <li> induknya, bukan sesudahnya." }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-012",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-04", "chapterModul": "html",
    "topik": "List & Link",
    "instruksi": "Buat daftar definisi <code>&lt;dl&gt;</code> berisi dua istilah. Istilah pertama harus <code>HTML</code>. Tambahkan juga tautan jangkar ke <code>#glosarium</code>, dan beri <code>id=\"glosarium\"</code> pada <code>&lt;dl&gt;</code>-nya.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Glosarium</title>\n</head>\n<body>\n\n  <h1>Glosarium</h1>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "dl#glosarium", "poin": 25, "label": "<dl id=\"glosarium\"> ditemukan" },
      { "type": "text_content_equals", "selector": "dl dt", "expected": "HTML", "poin": 25, "label": "istilah pertama = \"HTML\"" },
      { "type": "element_count_min", "selector": "dl dd", "min": 2, "poin": 25, "label": "ada minimal 2 definisi <dd>" },
      { "type": "attribute_equals", "selector": "a", "attribute": "href", "expected": "#glosarium", "poin": 25, "label": "tautan jangkar ke #glosarium" }
    ],
    "total_poin": 100
  },

  {
    "id": "html-dasar-013",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-05", "chapterModul": "html",
    "topik": "Gambar & Atribut",
    "instruksi": "Tampilkan gambar dari <code>https://placehold.co/320x180</code> dengan teks <code>alt</code> yang tidak kosong, <code>class=\"foto\"</code>, serta atribut <code>width=\"320\"</code> dan <code>height=\"180\"</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Gambar</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "attribute_equals", "selector": "img", "attribute": "src", "expected": "https://placehold.co/320x180", "poin": 25, "label": "atribut src benar" },
      { "type": "attribute_exists", "selector": "img", "attribute": "alt", "poin": 20, "label": "atribut alt ada" },
      { "type": "element_exists", "selector": "img.foto", "poin": 20, "label": "class=\"foto\" terpasang" },
      { "type": "attribute_equals", "selector": "img", "attribute": "width", "expected": "320", "poin": 20, "label": "width=\"320\"" },
      { "type": "attribute_equals", "selector": "img", "attribute": "height", "expected": "180", "poin": 15, "label": "height=\"180\"" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-014",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-05", "chapterModul": "html",
    "topik": "Gambar & Atribut",
    "instruksi": "Bungkus sebuah gambar dengan <code>&lt;figure&gt;</code> dan beri <code>&lt;figcaption&gt;</code> berisi keterangan minimal 3 kata. Gambarnya bebas, tapi <code>src</code> dan <code>alt</code> harus terisi.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Figure</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "figure img", "poin": 30, "label": "<img> berada di dalam <figure>" },
      { "type": "element_exists", "selector": "figure figcaption", "poin": 25, "label": "<figcaption> di dalam <figure>" },
      { "type": "text_min_word_count", "selector": "figcaption", "min_words": 3, "poin": 25, "label": "keterangan minimal 3 kata" },
      { "type": "attribute_exists", "selector": "figure img", "attribute": "alt", "poin": 20, "label": "gambar punya atribut alt" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-dasar-015",
    "modul": "HTML", "level": "Dasar", "chapterId": "html-05", "chapterModul": "html",
    "topik": "Gambar & Atribut",
    "instruksi": "Buat dua gambar. Gambar pertama informatif: beri <code>id=\"utama\"</code> dan <code>alt</code> minimal 3 kata. Gambar kedua dekoratif: beri <code>class=\"hiasan\"</code> dan <code>alt</code> <strong>kosong</strong>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Alt yang benar</title>\n</head>\n<body>\n\n  <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_exists", "selector": "img#utama", "poin": 25, "label": "<img id=\"utama\"> ditemukan" },
      { "type": "attribute_min_word_count", "selector": "img#utama", "attribute": "alt", "min_words": 3, "poin": 30, "label": "alt gambar utama minimal 3 kata" },
      { "type": "element_exists", "selector": "img.hiasan", "poin": 20, "label": "<img class=\"hiasan\"> ditemukan" },
      { "type": "attribute_equals", "selector": "img.hiasan", "attribute": "alt", "expected": "", "poin": 25, "label": "alt gambar hiasan kosong", "hint": "Tulis alt=\"\" — dikosongkan, bukan dihilangkan." }
    ],
    "total_poin": 100
  },

  {
    "id": "html-menengah-016",
    "modul": "HTML", "level": "Menengah", "chapterId": "html-06", "chapterModul": "html",
    "topik": "Tabel",
    "instruksi": "Lengkapi tabel: satu baris judul berisi dua <code>&lt;th&gt;</code> (<code>Mata Pelajaran</code> dan <code>Nilai</code>), dua baris data, lalu satu baris penutup dengan sel ber-<code>colspan=\"2\"</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Tabel Nilai</title>\n</head>\n<body>\n\n  <table border=\"1\">\n    <!-- ✏️ TULIS BARIS-BARIS TABEL DI SINI -->\n  </table>\n\n</body>\n</html>" },
    "assertions": [
      { "type": "descendant_count_min", "selector": "table", "child_selector": "th", "min": 2, "poin": 25, "label": "tabel punya minimal 2 <th>" },
      { "type": "text_content_equals", "selector": "table th", "expected": "Mata Pelajaran", "poin": 20, "label": "judul kolom pertama benar" },
      { "type": "descendant_count_min", "selector": "table", "child_selector": "tr", "min": 4, "poin": 25, "label": "tabel punya minimal 4 baris" },
      { "type": "attribute_equals", "selector": "table [colspan]", "attribute": "colspan", "expected": "2", "poin": 30, "label": "ada sel dengan colspan=\"2\"" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-menengah-017",
    "modul": "HTML", "level": "Menengah", "chapterId": "html-06", "chapterModul": "html",
    "topik": "Tabel",
    "instruksi": "Buat tabel jadwal lengkap dengan <code>&lt;caption&gt;</code> berisi <code>Jadwal Pelajaran</code>, bagian <code>&lt;thead&gt;</code>, dan <code>&lt;tbody&gt;</code> berisi minimal dua baris.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Jadwal</title>\n</head>\n<body>\n\n  <table border=\"1\">\n    <!-- ✏️ TULIS JAWABAN ANDA DI SINI -->\n    <!-- Ingat: <caption> harus jadi anak pertama <table> -->\n  </table>\n\n</body>\n</html>" },
    "assertions": [
      { "type": "text_content_equals", "selector": "table caption", "expected": "Jadwal Pelajaran", "poin": 30, "label": "<caption> = \"Jadwal Pelajaran\"" },
      { "type": "element_exists", "selector": "table thead tr th", "poin": 30, "label": "<thead> berisi baris judul" },
      { "type": "descendant_count_min", "selector": "table tbody", "child_selector": "tr", "min": 2, "poin": 40, "label": "<tbody> berisi minimal 2 baris" }
    ],
    "total_poin": 100
  },
  {
    "id": "html-menengah-018",
    "modul": "HTML", "level": "Menengah", "chapterId": "html-06", "chapterModul": "html",
    "topik": "Tabel",
    "instruksi": "Tabel ini punya judul di baris <em>dan</em> di kolom. Tambahkan atribut <code>scope</code> yang tepat: <code>scope=\"col\"</code> pada judul kolom di <code>&lt;thead&gt;</code>, dan <code>scope=\"row\"</code> pada judul baris di <code>&lt;tbody&gt;</code>.",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Scope</title>\n</head>\n<body>\n\n  <table border=\"1\">\n    <thead>\n      <tr>\n        <th>Mapel</th>\n        <th>Nilai</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <th>Fisika</th>\n        <td>88</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <!-- ✏️ TAMBAHKAN ATRIBUT scope PADA SETIAP <th> DI ATAS -->\n\n</body>\n</html>" },
    "assertions": [
      { "type": "element_count_min", "selector": "thead th[scope='col']", "min": 2, "poin": 50, "label": "dua <th> di <thead> ber-scope=\"col\"" },
      { "type": "element_exists", "selector": "tbody th[scope='row']", "poin": 50, "label": "<th> di <tbody> ber-scope=\"row\"" }
    ],
    "total_poin": 100
  },

