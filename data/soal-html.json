  {
    "id": "html-lanjutan-034",
    "modul": "HTML", "level": "Lanjutan", "chapterId": "html-12", "chapterModul": "html",
    "topik": "HTML5 API Ringan",
    "instruksi": "Buat dua panel lipat memakai <code>&lt;details&gt;</code> dan <code>&lt;summary&gt;</code>. Panel pertama harus punya <code>data-level=\"dasar\"</code> dan terbuka sejak awal (atribut <code>open</code>).",
    "starter_code": { "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Tanya Jawab</title>\n</head>\n<body>\n\n  <h1>Tanya Jawab</h1>\n\n  <!-- ✏️ TULIS DUA PANEL <details> DI SINI -->\n\n</body>\n</html>" },
